# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# The prototype runs fully WITHOUT any of these settings, using the deterministic
# stub adapter. Set SPT_LLM_PROVIDER=anthropic and supply a key only if you want
# the live model path. No other code changes are needed (NFR-17 / C-18).

# stub | anthropic
SPT_LLM_PROVIDER=stub

# Required only when SPT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model id used by the anthropic adapter
SPT_MODEL_ID=claude-sonnet-4-5

# Per-run token budget (NFR-16). The gateway refuses to send above this.
SPT_MAX_INPUT_TOKENS=12000
SPT_MAX_OUTPUT_TOKENS=3000

# Database file. Defaults to ./data/tracker.db
SPT_DB_PATH=data/tracker.db

# Where approved exports are written
SPT_EXPORT_DIR=exports
